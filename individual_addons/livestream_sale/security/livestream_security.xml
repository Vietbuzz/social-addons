<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_livestream" model="ir.module.category">
        <field name="name">Livestream</field>
        <field name="sequence">25</field>
    </record>

    <record id="res_groups_privilege_livestream" model="res.groups.privilege">
        <field name="name">Livestream</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="module_category_livestream"/>
    </record>

    <record id="group_livestream_user" model="res.groups">
        <field name="name">Livestream Assistant</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_livestream"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>

    <record id="group_livestream_manager" model="res.groups">
        <field name="name">Livestream Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_livestream"/>
        <field name="implied_ids" eval="[(4, ref('group_livestream_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
