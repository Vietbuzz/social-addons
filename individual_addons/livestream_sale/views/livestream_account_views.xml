<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="livestream_account_view_list" model="ir.ui.view">
        <field name="name">livestream.account.list</field>
        <field name="model">livestream.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="platform"/>
                <field name="external_id"/>
                <field name="payment_provider_id"/>
                <field name="token_state" widget="badge" decoration-success="token_state == 'valid'"
                       decoration-danger="token_state == 'invalid'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="livestream_account_view_form" model="ir.ui.view">
        <field name="name">livestream.account.form</field>
        <field name="model">livestream.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_setup_provider_journal" type="object" string="Post deposits to bank account"
                            invisible="not payment_provider_id"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="alert alert-danger" role="alert" invisible="token_state != 'invalid'">
                        <strong>Needs reconnection:</strong> <field name="token_error" readonly="1" class="d-inline"/>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. My Shop Page"/></h1></div>
                    <group name="main">
                        <group name="connection" string="Connection">
                            <field name="platform"/>
                            <field name="external_id"/>
                            <field name="access_token" password="True"/>
                            <field name="token_state" widget="badge" decoration-success="token_state == 'valid'"
                                   decoration-danger="token_state == 'invalid'"/>
                            <field name="token_checked_at"/>
                        </group>
                        <group name="deposit" string="Deposits">
                            <field name="payment_provider_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="livestream_account_action" model="ir.actions.act_window">
        <field name="name">Connected Accounts</field>
        <field name="res_model">livestream.account</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
